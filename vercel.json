{
  "crons": [
    {
      "path": "/api/cron/sync-products",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/cron/sync-products.js": { "maxDuration": 60 },
    "api/fetch-meta.js": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/brand",          "destination": "/brand.html" },
    { "source": "/login",          "destination": "/login.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" }
  ]
}
